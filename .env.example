# https://my.telegram.org -> API development tools
TG_API_ID=
TG_API_HASH=
# Must be OUTSIDE the repository; file is created by `airalert tg-login` with mode 600
TG_SESSION_PATH=~/.config/airalert/airalert.session
# Root for raw/, live/, processed/ (relative to repo root or absolute)
DATA_DIR=data
# Drone-monitoring channels collected by tg-live into data/live/drones.sqlite (comma-separated)
TG_DRONE_CHANNELS=kudy_letyt,kpszsu,kyiv_nebo
# On the first start tg-live downloads their history from this UTC date
TG_DRONE_SINCE=2026-08-10
# Alert channels (UkraineAlarmSignal, air_alert_ua) on an empty data/live: history from this UTC date
TG_ALERTS_SINCE=2026-08-25
# Contact (email or URL) for the alerts.in.ua User-Agent
SITREP_CONTACT=
